# 第7章：上回り・下回り足跡
vars: { d2.config.layout-engine: dagre; d2.config.pad: 12; direction: right }

title: "上回り・下回りの足跡" { near: top-center; style.font-size: 14; style.bold: true }

paths: {
  grid-rows: 2
  vertical-gap: 16

  upper: {
    direction: right
    style.font-size: 11
    u1: "e1(1)" { style.border-radius: 6 }
    u3: "e3(1)" { style.border-radius: 6 }
    uok: SUCCESS { style.fill: "#C6F6D5"; style.border-radius: 6 }
    u1 -> u3 -> uok
  }

  lower: {
    direction: right
    style.font-size: 11
    l1: "e1(0)" { style.border-radius: 6 }
    l2: "e2(1)" { style.border-radius: 6 }
    l4: "e4(1)" { style.border-radius: 6 }
    lok: SUCCESS { style.fill: "#C6F6D5"; style.border-radius: 6 }
    l1 -> l2 -> l4 -> lok
  }
}
