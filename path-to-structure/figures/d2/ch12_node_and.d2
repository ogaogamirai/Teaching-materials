# 第12章：積（AND）ノード例
vars: { d2.config.layout-engine: elk; d2.config.pad: 20; direction: right }

title: "積 — 両方 SUCCESS のときだけ SUCCESS" { near: top-center; style.font-size: 15; style.bold: true }

A: "Node_A\n0→FAIL / 1→SUCCESS" { style.fill: "#EBF8FF"; style.border-radius: 8 }
B: "Node_B\n0→FAIL / 1→SUCCESS" { style.fill: "#FFFAF0"; style.border-radius: 8 }
R: "新ノード\n0→FAIL / 1→SUCCESS" { style.fill: "#C6F6D5"; style.stroke: "#276749"; style.border-radius: 8; style.bold: true }

A -> R: "AND"
B -> R: "AND"
