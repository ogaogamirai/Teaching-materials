# 第2章：TSP 樹形図（横方向・6葉）
vars: { d2.config.layout-engine: dagre; d2.config.pad: 10; direction: right }

title: "樹形図 — 6通り（出発 A 固定）" { near: top-center; style.font-size: 15; style.bold: true }

start: "A" { style.fill: "#E3F2FD"; style.stroke: "#1565C0"; style.border-radius: 8; style.bold: true; style.font-size: 12 }

b2: B { style.border-radius: 6; style.font-size: 11 }
c2: C { style.border-radius: 6; style.font-size: 11 }
d2: D { style.border-radius: 6; style.font-size: 11 }

start -> b2: "2" { style.font-size: 10 }
start -> c2: "2" { style.font-size: 10 }
start -> d2: "2" { style.font-size: 10 }

bc3: C { style.border-radius: 6; style.font-size: 11 }
bd3: D { style.border-radius: 6; style.font-size: 11 }
cb3: B { style.border-radius: 6; style.font-size: 11 }
cd3: D { style.border-radius: 6; style.font-size: 11 }
db3: B { style.border-radius: 6; style.font-size: 11 }
dc3: C { style.border-radius: 6; style.font-size: 11 }

b2 -> bc3: "3" { style.font-size: 10 }
b2 -> bd3: "3" { style.font-size: 10 }
c2 -> cb3: "3" { style.font-size: 10 }
c2 -> cd3: "3" { style.font-size: 10 }
d2 -> db3: "3" { style.font-size: 10 }
d2 -> dc3: "3" { style.font-size: 10 }

bcd4: D { style.border-radius: 6; style.font-size: 11 }
bdc4: C { style.border-radius: 6; style.font-size: 11 }
cbd4: D { style.border-radius: 6; style.font-size: 11 }
cdb4: B { style.border-radius: 6; style.font-size: 11 }
dbd4: C { style.border-radius: 6; style.font-size: 11 }
dcd4: B { style.border-radius: 6; style.font-size: 11 }

bc3 -> bcd4: "4" { style.font-size: 10 }
bd3 -> bdc4: "4" { style.font-size: 10 }
cb3 -> cbd4: "4" { style.font-size: 10 }
cd3 -> cdb4: "4" { style.font-size: 10 }
db3 -> dbd4: "4" { style.font-size: 10 }
dc3 -> dcd4: "4" { style.font-size: 10 }

r1: "①" { style.fill: "#C6F6D5"; style.stroke: "#276749"; style.border-radius: 6; style.font-size: 11; style.bold: true }
r2: "②" { style.border-radius: 6; style.font-size: 11 }
r3: "③" { style.border-radius: 6; style.font-size: 11 }
r4: "④" { style.border-radius: 6; style.font-size: 11 }
r5: "⑤" { style.border-radius: 6; style.font-size: 11 }
r6: "⑥" { style.border-radius: 6; style.font-size: 11 }

bcd4 -> r1: { style.stroke: "#276749"; style.stroke-width: 2 }
bdc4 -> r2
cbd4 -> r3
cdb4 -> r4
dbd4 -> r5
dcd4 -> r6

note: "左端 = ① A→B→C→D→A ｜ 3×2×1=6" { near: bottom-center; style.font-size: 11; style.font-color: "#666" }
