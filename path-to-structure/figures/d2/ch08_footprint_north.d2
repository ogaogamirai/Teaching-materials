# 第8章：北回り足跡
vars: { d2.config.layout-engine: elk; d2.config.pad: 8 }

title: "北回り — e1, e3, e5" { near: top-center; style.font-size: 12; style.bold: true }

chain: {
  grid-columns: 4
  horizontal-gap: 12
  e1: "e1(1)" { style.fill: "#EBF8FF"; style.border-radius: 6; style.font-size: 11 }
  e3: "e3(1)" { style.border-radius: 6; style.font-size: 11 }
  e5: "e5(1)" { style.fill: "#C6F6D5"; style.border-radius: 6; style.font-size: 11 }
  ok: SUCCESS { style.fill: "#C6F6D5"; style.border-radius: 6; style.font-size: 11 }
  e1 -> e3 -> e5 -> ok
}
