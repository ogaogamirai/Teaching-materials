# 第11章：袋A/B データ構造（横並び）
vars: { d2.config.layout-engine: elk; d2.config.pad: 14; direction: right }

title: "袋A と 袋B — 同型のノード列" { near: top-center; style.font-size: 15; style.bold: true }

bags: {
  grid-columns: 2
  horizontal-gap: 40

  bagA: {
    label: "袋A"
    style.fill: "#EBF8FF"
    style.border-radius: 10
    direction: right

    A_e1: "e1" { style.border-radius: 6; style.font-size: 11 }
    A_e5: "e5" { style.border-radius: 6; style.font-size: 11 }
    A_e4: "e4→OK" { style.fill: "#C6F6D5"; style.border-radius: 6; style.font-size: 11 }

    A_e1 -> A_e5 -> A_e4
  }

  bagB: {
    label: "袋B"
    style.fill: "#FFFAF0"
    style.border-radius: 10
    direction: right

    B_e1: "e1" { style.border-radius: 6; style.font-size: 11 }
    B_e5: "e5" { style.border-radius: 6; style.font-size: 11 }
    B_e4: "e4→OK" { style.fill: "#C6F6D5"; style.border-radius: 6; style.font-size: 11 }

    B_e1 -> B_e5 -> B_e4
  }
}

apply: "Apply\n（積）" { style.font-size: 12; style.bold: true }
result: "e1→e5→e4" { style.fill: "#C6F6D5"; style.stroke: "#276749"; style.border-radius: 8; style.bold: true }

bags -> apply -> result
