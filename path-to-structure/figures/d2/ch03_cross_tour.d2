# 第3章：クロスした巡回
vars: { d2.config.layout-engine: elk; d2.config.pad: 16; direction: down }

title: "交差巡回 A→D→C→B→A（約19.4）" { near: top-center; style.font-size: 14; style.bold: true }

town: {
  grid-rows: 2
  grid-columns: 2
  horizontal-gap: 64
  vertical-gap: 48

  A: "A" { style.border-radius: 8; style.font-size: 11 }
  B: "B" { style.border-radius: 8; style.font-size: 11 }
  C: "C" { style.border-radius: 8; style.font-size: 11 }
  D: "D" { style.border-radius: 8; style.font-size: 11 }

  A -> D: "5.7" { style.stroke: "#C53030"; style.stroke-width: 3 }
  D -> C: "4.0" { style.stroke: "#C53030" }
  C -> B: "5.7" { style.stroke: "#C53030" }
  B -> A: "4.0" { style.stroke: "#C53030" }
}

note: "× クロス" { near: bottom-center; style.font-color: "#C53030"; style.font-size: 12; style.bold: true }
