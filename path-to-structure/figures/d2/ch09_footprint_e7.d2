# 第9章：コース②足跡
vars: { d2.config.layout-engine: elk; d2.config.pad: 8 }

title: "コース② e1→e3(0)→e4→e7" { near: top-center; style.font-size: 11; style.bold: true }

chain: {
  grid-columns: 5
  horizontal-gap: 10
  e1: "e1(1)" { style.border-radius: 6; style.font-size: 11 }
  e3: "e3(0)" { style.fill: "#FFFAF0"; style.border-radius: 6; style.font-size: 11 }
  e4: "e4(1)" { style.border-radius: 6; style.font-size: 11 }
  e7: "e7(1)" { style.fill: "#EBF8FF"; style.border-radius: 6; style.font-size: 11 }
  ok: SUCCESS { style.fill: "#C6F6D5"; style.border-radius: 6; style.font-size: 11 }
  e1 -> e3 -> e4 -> e7 -> ok
}
