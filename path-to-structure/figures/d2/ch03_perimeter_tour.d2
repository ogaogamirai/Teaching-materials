# 第3章：外周巡回
vars: { d2.config.layout-engine: elk; d2.config.pad: 16; direction: down }

title: "外周巡回 A→B→D→C→A（16.0）" { near: top-center; style.font-size: 14; style.bold: true }

town: {
  grid-rows: 2
  grid-columns: 2
  horizontal-gap: 64
  vertical-gap: 48

  A: A { style.border-radius: 8; style.font-size: 11 }
  B: B { style.border-radius: 8; style.font-size: 11 }
  C: C { style.border-radius: 8; style.font-size: 11 }
  D: D { style.border-radius: 8; style.font-size: 11 }

  A -> B: "4.0" { style.stroke: "#276749"; style.stroke-width: 3 }
  B -> D: "4.0" { style.stroke: "#276749" }
  D -> C: "4.0" { style.stroke: "#276749" }
  C -> A: "4.0" { style.stroke: "#276749" }
}

note: "2-opt: 19.4 → 16.0" { near: bottom-center; style.font-size: 11; style.font-color: "#276749" }
