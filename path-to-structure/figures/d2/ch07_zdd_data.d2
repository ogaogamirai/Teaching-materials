# 第7章：ZDD — 上回り/下回りを2行、0/1 はエッジ上
# ビルド: python tools/build_figures_d2.py

vars: {
  d2.config.layout-engine: elk
  d2.config.pad: 16
  direction: right
}

title: "ZDD データ — 0/1 はエッジ上" {
  near: top-center
  style.font-size: 16
  style.bold: true
}

start: Node_e1 { style.fill: "#E3F2FD"; style.stroke: "#1565C0"; style.border-radius: 8 }
ok: SUCCESS { style.fill: "#C6F6D5"; style.stroke: "#276749"; style.border-radius: 8 }

routes: {
  grid-rows: 2
  vertical-gap: 32
  horizontal-gap: 36

  upper: {
    direction: right
    n3: Node_e3 { style.fill: "#F7F8FE"; style.stroke: "#0D32B2"; style.border-radius: 8 }
    n3 -> ok: "1" { style.stroke: "#276749" }
  }

  lower: {
    direction: right
    n2: Node_e2 { style.fill: "#F7F8FE"; style.stroke: "#0D32B2"; style.border-radius: 8 }
    n4: Node_e4 { style.fill: "#F7F8FE"; style.stroke: "#0D32B2"; style.border-radius: 8 }
    n2 -> n4: "1"
    n4 -> ok: "1" { style.stroke: "#276749" }
  }
}

start -> routes.upper.n3: "1" { style.stroke: "#3182ce"; style.font-size: 14 }
start -> routes.lower.n2: "0" { style.stroke: "#d69e2e"; style.font-size: 14 }

note: "0 枝の途中 → FAIL（省略）" {
  near: bottom-center
  style.font-size: 11
  style.font-color: "#666666"
}
