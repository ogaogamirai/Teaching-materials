# 付録A1：上・下回り足跡
vars: { d2.config.layout-engine: elk; d2.config.pad: 12; direction: right }

title: "上回り・下回りの足跡" { near: top-center; style.font-size: 14; style.bold: true }

paths: {
  grid-rows: 2
  vertical-gap: 14

  upper: "上: #1(1)→#3(1)→SUCCESS" {
    style.fill: "#EBF8FF"
    style.stroke: "#3182ce"
    style.border-radius: 8
    style.font-size: 11
    style.bold: true
  }
  lower: "下: #1(0)→#2(1)→#4(1)→SUCCESS" {
    style.fill: "#FFFAF0"
    style.stroke: "#d69e2e"
    style.border-radius: 8
    style.font-size: 11
    style.bold: true
  }
}
