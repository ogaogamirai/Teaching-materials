# 第8章：南回り足跡
vars: { d2.config.layout-engine: elk; d2.config.pad: 8 }

title: "南回り — e2, e4, e5" { near: top-center; style.font-size: 12; style.bold: true }

chain: {
  grid-columns: 5
  horizontal-gap: 10
  e1: "e1(0)" { style.fill: "#FFFAF0"; style.border-radius: 6; style.font-size: 11 }
  e2: "e2(1)" { style.border-radius: 6; style.font-size: 11 }
  e4: "e4(1)" { style.border-radius: 6; style.font-size: 11 }
  e5: "e5(1)" { style.fill: "#C6F6D5"; style.border-radius: 6; style.font-size: 11 }
  ok: SUCCESS { style.fill: "#C6F6D5"; style.border-radius: 6; style.font-size: 11 }
  e1 -> e2 -> e4 -> e5 -> ok
}
