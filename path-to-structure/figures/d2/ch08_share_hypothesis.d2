# 第8章：共有 vs 複製（思考実験）
vars: { d2.config.layout-engine: elk; d2.config.pad: 20; direction: right }

title: "Node_e5 を共有する vs 複製する" { near: top-center; style.font-size: 16; style.bold: true }

share: {
  label: "【共有あり】"
  style.fill: "#F0FFF4"
  style.stroke: "#276749"
  style.border-radius: 10

  e3s: "Node_e3" { style.border-radius: 8 }
  e5s: "Node_e5\n1行だけ" { style.fill: "#C6F6D5"; style.border-radius: 8; style.bold: true }
  e4s: "Node_e4" { style.border-radius: 8 }

  e3s -> e5s
  e4s -> e5s
}

copy: {
  label: "【複製した場合】"
  style.fill: "#FFF5F5"
  style.stroke: "#C53030"
  style.border-radius: 10

  e5n: "Node_e5_north" { style.border-radius: 8 }
  e5s2: "Node_e5_south" { style.border-radius: 8 }

  note: "同じ内容が2行\n→ 無駄" { style.font-size: 11; style.font-color: "#C53030" }
}

share -> copy: "比較" { style.stroke-dash: 4 }
