# 第5章：同形統合（統合前）
vars: { d2.config.layout-engine: dagre; d2.config.pad: 16; direction: down }

title: "同形統合前 — 同じ行き先が二重" { near: top-center; style.font-size: 16; style.bold: true }

Qx: "質問X" { style.fill: "#E3F2FD"; style.border-radius: 8 }
Qy: "質問Y" { style.fill: "#E3F2FD"; style.border-radius: 8 }
A: A { style.border-radius: 8 }
B: B { style.border-radius: 8 }

Qx -> A: "0"
Qx -> B: "1"
Qy -> A: "0"
Qy -> B: "1"

note: "0枝・1枝の行き先が完全に同じ" { near: bottom-center; style.font-size: 12; style.font-color: "#666" }
