# 第1章：E罠付き5交差点
vars: { d2.config.layout-engine: elk; d2.config.pad: 16; direction: down }

title: "A → D（E は近いが行き止まり）" { near: top-center; style.font-size: 15; style.bold: true }

E: "E" { style.fill: "#FED7D7"; style.stroke: "#C53030"; style.border-radius: 8; style.font-size: 12 }

town: {
  grid-rows: 2
  grid-columns: 2
  horizontal-gap: 56
  vertical-gap: 48
  style.fill: "#F7F8FE"
  style.stroke: "#0D32B2"
  style.border-radius: 12

  A: "A\nスタート" { style.fill: "#E3F2FD"; style.font-size: 11 }
  B: B { style.font-size: 11 }
  C: C { style.font-size: 11 }
  D: "D\nゴール" { style.fill: "#C6F6D5"; style.font-size: 11 }

  A -> B: "3分" { style.stroke: "#3182ce" }
  A -> C: "5分" { style.stroke: "#d69e2e" }
  B -> D: "2分" { style.stroke: "#3182ce" }
  C -> D: "1分" { style.stroke: "#276749"; style.stroke-width: 3 }
}

E -> town.A: "1分\n(罠)" { style.stroke: "#C53030"; style.stroke-dash: 4; style.font-size: 10 }
